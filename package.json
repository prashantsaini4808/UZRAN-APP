{
  "name": "uzran-marketplace",
  "version": "1.1.0",
  "private": true,
  "description": "UZRAN marketplace full-stack starter with Capacitor Android wrapper configuration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:web": "node scripts/prepare-web.js",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build:web && npx cap sync android",
    "cap:open:android": "npx cap open android"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "razorpay": "^2.9.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@capacitor/assets": "^3.0.5"
  }
}
